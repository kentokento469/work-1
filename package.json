{
  "name": "workcore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WorkCore - 中小企業向け統合業務管理・自動化Webアプリ",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs && node scripts/build-postal-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/build-postal-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "idb": "^8.0.0",
    "libphonenumber-js": "1.12.29",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jp-postal": "4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
